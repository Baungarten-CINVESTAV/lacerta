    pin("wbs_sel_i[2]") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("wbs_sel_i[1]") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("wbs_sel_i[0]") {
      direction : input;
      capacitance : 0.0000;
    }
    }
  }

}
